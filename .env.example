# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it contains your bot token.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord user ID (enable Developer Mode, then right-click your profile).
# Registered as the bot owner.
OWNER_ID=123456789012345678

# Optional: path to the SQLite database file (default: data/bot.db).
# On Railway/Render point this at a persistent volume, e.g. /data/bot.db
# DATABASE_PATH=data/bot.db

# Optional: your test server ID. Slash commands sync to it instantly
# (global sync can take up to an hour). Leave commented out in production.
# GUILD_ID=123456789012345678
